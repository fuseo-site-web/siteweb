# Copier vers .env.local (local) ; en production, saisir ces variables dans Netlify > Site configuration > Environment variables.
# Ne jamais committer de valeurs.

# URL publique : http://localhost:3000 en local, https://fuseo.net en production
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Mesure d'audience (identifiants publics, chargés seulement après consentement). Vide = rien n'est chargé.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Jeton de la balise meta de vérification Google Search Console
NEXT_PUBLIC_GSC_VERIFICATION=

# Serveur uniquement (jamais exposées au navigateur)
SUPABASE_SERVICE_ROLE_KEY=

# Recherche de vol par numéro (fournisseur à confirmer, voir docs/PLAN-REFONTE.md §5)
AVIATIONSTACK_API_KEY=

# E-mails transactionnels (Resend, région UE) : serveur uniquement
RESEND_API_KEY=

# Chiffrement des données de santé (AES-256-GCM) : 32 octets en base64, serveur uniquement. Générer : openssl rand -base64 32
HEALTH_ENCRYPTION_KEY=
HEALTH_ENCRYPTION_KEY_ID=k1
